#version 450
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(set=0,binding=0) uniform sampler2D source;
layout(set=0,binding=1,rgba16f) uniform writeonly image2DArray destination;
layout(push_constant) uniform Params{int mode;float roughness;int size;int samples;}p;
const float PI=3.14159265359;
vec2 hammersley(uint i,uint n){return vec2(float(i)/float(n),float(bitfieldReverse(i))*2.3283064365386963e-10);}
vec3 direction(vec2 a,int face){if(face==0)return normalize(vec3(1,-a.y,-a.x));if(face==1)return normalize(vec3(-1,-a.y,a.x));if(face==2)return normalize(vec3(a.x,1,a.y));if(face==3)return normalize(vec3(a.x,-1,-a.y));if(face==4)return normalize(vec3(a.x,-a.y,1));return normalize(vec3(-a.x,-a.y,-1));}
vec3 environment(vec3 d){return textureLod(source,vec2(atan(d.z,d.x)/(2*PI)+.5,acos(clamp(d.y,-1,1))/PI),0).rgb;}
mat3 basis(vec3 n){vec3 up=abs(n.z)<.999?vec3(0,0,1):vec3(1,0,0);vec3 t=normalize(cross(up,n));return mat3(t,cross(n,t),n);}
vec3 sampleGGX(vec2 u,float roughness){float a=roughness*roughness;float cosTheta=sqrt((1-u.y)/(1+(a*a-1)*u.y));float sinTheta=sqrt(max(0,1-cosTheta*cosTheta));return vec3(cos(2*PI*u.x)*sinTheta,sin(2*PI*u.x)*sinTheta,cosTheta);}
void main(){ivec3 pixel=ivec3(gl_GlobalInvocationID);if(pixel.x>=p.size||pixel.y>=p.size)return;vec2 uv=(vec2(pixel.xy)+.5)/float(p.size);vec3 result=vec3(0);float weight=0;
 if(p.mode==2){float nv=max(uv.x,.001),r=uv.y;vec3 v=vec3(sqrt(1-nv*nv),0,nv);vec2 integrated=vec2(0);for(uint i=0;i<uint(p.samples);i++){vec3 h=sampleGGX(hammersley(i,uint(p.samples)),r);vec3 l=normalize(2*dot(v,h)*h-v);float nl=max(l.z,0),nh=max(h.z,0),vh=max(dot(v,h),0);if(nl>0){float a=r*r,k=a*.5;float gv=nv/(nv*(1-k)+k),gl=nl/(nl*(1-k)+k);float vis=gv*gl*vh/max(nh*nv,.0001);float fc=pow(1-vh,5);integrated+=vec2(1-fc,fc)*vis;}}imageStore(destination,pixel,vec4(integrated/float(p.samples),0,1));return;}
 vec3 n=direction(uv*2-1,pixel.z);mat3 tbn=basis(n);if(p.mode==0&&p.roughness<.001){imageStore(destination,pixel,vec4(environment(n),1));return;}
 for(uint i=0;i<uint(p.samples);i++){vec2 u=hammersley(i,uint(p.samples));if(p.mode==1){float r=sqrt(u.y);vec3 l=tbn*vec3(r*cos(2*PI*u.x),r*sin(2*PI*u.x),sqrt(1-u.y));result+=environment(l);weight+=1;}else{vec3 h=tbn*sampleGGX(u,p.roughness);vec3 l=normalize(2*dot(n,h)*h-n);float nl=max(dot(n,l),0);if(nl>0){result+=environment(l)*nl;weight+=nl;}}}imageStore(destination,pixel,vec4(result/max(weight,.001),1));}
